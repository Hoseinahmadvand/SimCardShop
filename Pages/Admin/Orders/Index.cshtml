@page "/Admin/Orders"
@model SimCardShop.Pages.Admin.Orders.IndexModel
@{
    ViewData["Title"] = "مدیریت سفارش‌ها";
}

<h1 class="text-xl font-extrabold text-ink mb-6">مدیریت سفارش‌ها</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="rounded-xl bg-emerald-50 text-emerald-800 text-sm p-3 mb-5">@Model.StatusMessage</div>
}

<form method="get" class="card-base p-4 mb-6 flex flex-wrap gap-3">
    <input type="text" name="q" value="@Model.Q" placeholder="کد سفارش، نام یا موبایل مشتری، شماره..."
           class="field-input !py-2 w-72" />
    <select name="status" class="field-select text-sm">
        <option value="">همه وضعیت‌ها</option>
        <option value="New" selected="@(Model.Status == "New")">جدید</option>
        <option value="Paid" selected="@(Model.Status == "Paid")">پرداخت شده</option>
        <option value="InProgress" selected="@(Model.Status == "InProgress")">در حال انجام</option>
        <option value="Completed" selected="@(Model.Status == "Completed")">تکمیل شده</option>
        <option value="Cancelled" selected="@(Model.Status == "Cancelled")">لغو شده</option>
    </select>
    <button type="submit" class="btn-primary !py-2 !px-5 text-sm">فیلتر</button>
    <a href="/Admin/Orders" class="text-sm text-muted self-center">حذف فیلتر</a>
</form>

<div class="table-wrap">
    <table class="table-modern w-full text-sm">
        <thead>
            <tr class="text-muted text-right border-b border-slate-100">
                <th class="py-3 px-4 font-medium">کد سفارش</th>
                <th class="py-3 px-4 font-medium">شماره</th>
                <th class="py-3 px-4 font-medium">مشتری</th>
                <th class="py-3 px-4 font-medium">موبایل</th>
                <th class="py-3 px-4 font-medium">مبلغ</th>
                <th class="py-3 px-4 font-medium">وضعیت</th>
                <th class="py-3 px-4 font-medium">تاریخ</th>
                <th class="py-3 px-4 font-medium">جزئیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Results)
            {
                var sim = order.Items.FirstOrDefault()?.SimCard;
                <tr class="border-b border-slate-50">
                    <td class="py-3 px-4 font-medium">@order.OrderCode</td>
                    <td class="py-3 px-4" dir="ltr">@(sim?.DisplayNumber ?? "-")</td>
                    <td class="py-3 px-4">@order.CustomerName</td>
                    <td class="py-3 px-4" dir="ltr">@order.CustomerMobile</td>
                    <td class="py-3 px-4">@order.TotalAmount.ToString("N0")</td>
                    <td class="py-3 px-4">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <span class="chip">@DisplayLabels.OrderStatus(order.Status)</span>
                            @if (order.IsPaid)
                            {
                                <span class="badge-success" title="@order.PaymentGateway">
                                    <svg data-lucide="credit-card" class="w-3 h-3"></svg>آنلاین
                                </span>
                            }
                        </div>
                    </td>
                    <td class="py-3 px-4 text-muted">@order.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                    <td class="py-3 px-4">
                        <a href="/Admin/Orders/Details/@order.Id" class="text-primary font-semibold">مشاهده</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Results.Any())
    {
        <p class="text-muted text-sm p-6 text-center">سفارشی یافت نشد.</p>
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="flex items-center justify-center gap-2 mt-6">
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            var isCurrent = p == Model.Page;
            <a href="?q=@Model.Q&status=@Model.Status&page=@p"
               class="w-9 h-9 flex items-center justify-center rounded-full text-sm @(isCurrent ? "bg-primary text-white" : "text-secondary hover:bg-slate-100")">
                @p
            </a>
        }
    </div>
}
