@{
    var path = Context.Request.Path.Value ?? "";
    bool IsActive(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
    string LinkClass(string prefix, bool exact = false) =>
        (exact ? path.Equals(prefix, StringComparison.OrdinalIgnoreCase) : IsActive(prefix))
            ? "sidebar-link active" : "sidebar-link";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | پنل مدیریت" : "پنل مدیریت")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lucide-static/0.474.0/umd/lucide.min.js" defer></script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="min-h-screen bg-surface font-sans">
    <div class="flex min-h-screen">

        <!-- Sidebar -->
        <aside class="hidden md:flex md:flex-col w-64 bg-ink text-white shrink-0">
            <div class="h-16 flex items-center gap-2.5 px-5 border-b border-white/10">
                <span class="w-8 h-8 rounded-xl bg-primary text-white flex items-center justify-center font-extrabold text-sm">ش</span>
                <span class="font-bold text-sm">پنل مدیریت</span>
            </div>
            <nav class="flex-1 px-3 py-4 space-y-1 text-sm overflow-y-auto">
                <a href="/Admin" class="@LinkClass("/Admin", true)">
                    <svg data-lucide="layout-dashboard" class="w-4 h-4"></svg>داشبورد
                </a>
                <a href="/Admin/SimCards" class="@LinkClass("/Admin/SimCards")">
                    <svg data-lucide="phone" class="w-4 h-4"></svg>مدیریت شماره‌ها
                </a>
                <a href="/Admin/Orders" class="@LinkClass("/Admin/Orders")">
                    <svg data-lucide="shopping-cart" class="w-4 h-4"></svg>مدیریت سفارش‌ها
                </a>
                <a href="/Admin/Crm" class="@LinkClass("/Admin/Crm")">
                    <svg data-lucide="users" class="w-4 h-4"></svg>مشتریان (CRM)
                </a>
                <div class="pt-3 mt-3 border-t border-white/10 text-white/35 text-xs px-3 font-semibold">پیامک تبلیغاتی</div>
                <a href="/Admin/Sms/Send" class="@LinkClass("/Admin/Sms/Send")">
                    <svg data-lucide="send" class="w-4 h-4"></svg>ارسال پیامک
                </a>
                <a href="/Admin/Sms/Templates" class="@LinkClass("/Admin/Sms/Templates")">
                    <svg data-lucide="file-text" class="w-4 h-4"></svg>قالب‌های پیامک
                </a>
                <a href="/Admin/Sms/History" class="@LinkClass("/Admin/Sms/History")">
                    <svg data-lucide="history" class="w-4 h-4"></svg>تاریخچه پیامک‌ها
                </a>
                <a href="/Admin/Sms/OptOuts" class="@LinkClass("/Admin/Sms/OptOuts")">
                    <svg data-lucide="bell-off" class="w-4 h-4"></svg>لیست عدم ارسال
                </a>
                <a href="/Admin/Statistics" class="@LinkClass("/Admin/Statistics")">
                    <svg data-lucide="bar-chart-3" class="w-4 h-4"></svg>آمار بازدید و کلیک
                </a>
                @if (Context.User.IsInRole("Admin"))
                {
                    <div class="pt-3 mt-3 border-t border-white/10 text-white/35 text-xs px-3 font-semibold">فقط برای مدیر</div>
                    <a href="/Admin/Users" class="@LinkClass("/Admin/Users")">
                        <svg data-lucide="user-cog" class="w-4 h-4"></svg>کاربران و فروش
                    </a>
                    <a href="/Admin/Settings" class="@LinkClass("/Admin/Settings")">
                        <svg data-lucide="settings" class="w-4 h-4"></svg>تنظیمات سایت
                    </a>
                }
            </nav>
            <div class="p-3 border-t border-white/10 space-y-2">
                <a href="/" class="flex items-center justify-center gap-1.5 text-xs text-white/50 hover:text-white/80 py-1.5">
                    <svg data-lucide="external-link" class="w-3.5 h-3.5"></svg>مشاهده سایت
                </a>
                <form method="post" asp-page="/Admin/Logout">
                    <button type="submit" class="w-full flex items-center justify-center gap-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-sm font-medium py-2.5 transition-colors">
                        <svg data-lucide="log-out" class="w-4 h-4"></svg>خروج
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main -->
        <div class="flex-1 min-w-0">
            <header class="md:hidden h-14 bg-card border-b border-line flex items-center justify-between px-4 sticky top-0 z-30">
                <span class="font-bold text-ink flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-primary text-white flex items-center justify-center font-extrabold text-xs">ش</span>
                    پنل مدیریت
                </span>
                <form method="post" asp-page="/Admin/Logout">
                    <button type="submit" class="text-sm text-secondary flex items-center gap-1">
                        <svg data-lucide="log-out" class="w-4 h-4"></svg>خروج
                    </button>
                </form>
            </header>
            <main class="p-4 md:p-8 max-w-[1400px]">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
