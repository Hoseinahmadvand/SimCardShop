@page "/Admin/Sms/OptOuts"
@model SimCardShop.Pages.Admin.Sms.OptOutsModel
@{
    ViewData["Title"] = "لیست عدم ارسال پیامک";
}

<div class="flex items-center gap-3 mb-6">
    <a href="/Admin/Sms/Send" class="text-muted text-sm">ارسال پیامک</a>
    <span class="text-muted">/</span>
    <h1 class="text-xl font-extrabold text-ink">لیست عدم ارسال پیامک تبلیغاتی</h1>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="rounded-xl bg-emerald-50 text-emerald-800 text-sm p-3 mb-5">@Model.StatusMessage</div>
}

<div class="grid md:grid-cols-3 gap-6">
    <form method="post" asp-page-handler="Add" class="md:col-span-1 card-base p-6">
        <h2 class="font-bold text-ink mb-4">افزودن شماره</h2>
        <div class="mb-4">
            <label asp-for="Input.Mobiles" class="field-label"></label>
            <textarea asp-for="Input.Mobiles" rows="5" dir="ltr" placeholder="09120000001"
                      class="field-input text-right"></textarea>
            <span asp-validation-for="Input.Mobiles" class="field-error"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Input.Note" class="field-label"></label>
            <input asp-for="Input.Note" class="field-input" />
        </div>
        <button type="submit" class="btn-primary w-full">افزودن به لیست</button>
    </form>

    <div class="md:col-span-2 table-wrap">
        <table class="table-modern w-full text-sm">
            <thead>
                <tr class="text-muted text-right border-b border-slate-100">
                    <th class="py-3 px-4 font-medium">موبایل</th>
                    <th class="py-3 px-4 font-medium">یادداشت</th>
                    <th class="py-3 px-4 font-medium">تاریخ ثبت</th>
                    <th class="py-3 px-4 font-medium">حذف</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr class="border-b border-slate-50">
                        <td class="py-3 px-4" dir="ltr">@item.Mobile</td>
                        <td class="py-3 px-4 text-muted">@(item.Note ?? "-")</td>
                        <td class="py-3 px-4 text-muted">@item.CreatedAt.ToString("yyyy/MM/dd")</td>
                        <td class="py-3 px-4">
                            <form method="post" asp-page-handler="Remove" asp-route-id="@item.Id">
                                <button type="submit" class="text-danger">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Items.Any())
        {
            <p class="text-muted text-sm p-6 text-center">لیست عدم ارسال خالی است.</p>
        }
    </div>
</div>
