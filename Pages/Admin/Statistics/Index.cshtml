@page "/Admin/Statistics"
@model SimCardShop.Pages.Admin.Statistics.IndexModel
@{
    ViewData["Title"] = "آمار بازدید و کلیک";
}

<h1 class="text-xl font-extrabold text-ink mb-6">آمار بازدید و کلیک شماره‌ها</h1>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="card-base p-5">
        <div class="field-label">مجموع بازدید</div>
        <div class="text-2xl font-extrabold">@Model.TotalViews</div>
    </div>
    <div class="card-base p-5 card-featured">
        <div class="field-label">کلیک روی خرید</div>
        <div class="text-2xl font-extrabold">@Model.TotalBuyClicks</div>
    </div>
    <div class="card-base p-5">
        <div class="field-label">کلیک تماس</div>
        <div class="text-2xl font-extrabold">@Model.TotalCallClicks</div>
    </div>
    <div class="card-base p-5">
        <div class="field-label">کلیک واتس‌اپ</div>
        <div class="text-2xl font-extrabold">@Model.TotalWhatsAppClicks</div>
    </div>
</div>

<form method="get" class="flex items-center gap-3 mb-4">
    <label class="text-sm text-muted">مرتب‌سازی بر اساس:</label>
    <select name="sort" onchange="this.form.submit()" class="field-select text-sm">
        <option value="views" selected="@(Model.Sort == "views")">بیشترین بازدید</option>
        <option value="buyClicks" selected="@(Model.Sort == "buyClicks")">بیشترین کلیک خرید</option>
        <option value="callClicks" selected="@(Model.Sort == "callClicks")">بیشترین کلیک تماس</option>
    </select>
</form>

<div class="table-wrap">
    <table class="table-modern w-full text-sm">
        <thead>
            <tr class="text-muted text-right border-b border-slate-100">
                <th class="py-3 px-4 font-medium">شماره</th>
                <th class="py-3 px-4 font-medium">وضعیت</th>
                <th class="py-3 px-4 font-medium">بازدید</th>
                <th class="py-3 px-4 font-medium">کلیک خرید</th>
                <th class="py-3 px-4 font-medium">کلیک تماس</th>
                <th class="py-3 px-4 font-medium">کلیک واتس‌اپ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sim in Model.TopSimCards)
            {
                <tr class="border-b border-slate-50">
                    <td class="py-3 px-4">
                        <a href="/i/@sim.Number" class="number-plate text-base text-navy">@sim.DisplayNumber</a>
                    </td>
                    <td class="py-3 px-4">@DisplayLabels.SimCardStatus(sim.Status)</td>
                    <td class="py-3 px-4">@sim.ViewCount</td>
                    <td class="py-3 px-4">@sim.BuyClickCount</td>
                    <td class="py-3 px-4">@sim.CallClickCount</td>
                    <td class="py-3 px-4">@sim.WhatsAppClickCount</td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.TopSimCards.Any())
    {
        <p class="text-muted text-sm p-6 text-center">هنوز آماری ثبت نشده است.</p>
    }
</div>
