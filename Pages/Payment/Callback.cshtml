@page "/payment/callback"
@model SimCardShop.Pages.Payment.CallbackModel
@{
    ViewData["Title"] = Model.Success ? "پرداخت موفق" : "نتیجه پرداخت";
    var simCard = Model.Order?.Items.FirstOrDefault()?.SimCard;
}

<section class="section max-w-lg py-16 md:py-24 text-center">

    @if (Model.Success)
    {
        <span class="w-16 h-16 mx-auto rounded-2xl bg-success/10 text-success flex items-center justify-center mb-5">
            <svg data-lucide="badge-check" class="w-8 h-8"></svg>
        </span>
        <h1 class="text-2xl font-extrabold text-ink mb-2">پرداخت با موفقیت انجام شد</h1>
        <p class="text-secondary mb-8">سفارش شما ثبت و پرداخت آن تایید شد. کارشناسان دفتر به‌زودی برای هماهنگی تحویل شماره با شما تماس می‌گیرند.</p>

        @if (Model.Order is not null)
        {
            <div class="panel p-6 text-right mb-8">
                <dl class="space-y-3 text-sm">
                    <div class="flex items-center justify-between">
                        <dt class="text-secondary">کد سفارش</dt>
                        <dd class="font-bold text-ink">@Model.Order.OrderCode</dd>
                    </div>
                    @if (simCard is not null)
                    {
                        <div class="flex items-center justify-between">
                            <dt class="text-secondary">شماره</dt>
                            <dd class="number-plate text-base">@simCard.DisplayNumber</dd>
                        </div>
                    }
                    <div class="flex items-center justify-between">
                        <dt class="text-secondary">مبلغ پرداخت‌شده</dt>
                        <dd class="font-bold text-ink">@Model.Order.TotalAmount.ToString("N0") تومان</dd>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Order.PaymentRefId))
                    {
                        <div class="flex items-center justify-between">
                            <dt class="text-secondary">کد پیگیری تراکنش</dt>
                            <dd class="font-semibold text-ink" dir="ltr">@Model.Order.PaymentRefId</dd>
                        </div>
                    }
                </dl>
            </div>
        }

        <a href="/" class="btn-accent">
            <svg data-lucide="home" class="w-4 h-4"></svg>
            بازگشت به صفحه اصلی
        </a>
    }
    else
    {
        <span class="w-16 h-16 mx-auto rounded-2xl bg-danger/10 text-danger flex items-center justify-center mb-5">
            <svg data-lucide="circle-x" class="w-8 h-8"></svg>
        </span>
        <h1 class="text-2xl font-extrabold text-ink mb-2">پرداخت انجام نشد</h1>
        <p class="text-secondary mb-8">@Model.ErrorMessage</p>

        @if (Model.Order is not null)
        {
            <div class="panel p-6 text-right mb-8">
                <dl class="space-y-3 text-sm">
                    <div class="flex items-center justify-between">
                        <dt class="text-secondary">کد سفارش</dt>
                        <dd class="font-bold text-ink">@Model.Order.OrderCode</dd>
                    </div>
                    @if (simCard is not null)
                    {
                        <div class="flex items-center justify-between">
                            <dt class="text-secondary">شماره</dt>
                            <dd class="number-plate text-base">@simCard.DisplayNumber</dd>
                        </div>
                    }
                    <div class="flex items-center justify-between">
                        <dt class="text-secondary">مبلغ قابل پرداخت</dt>
                        <dd class="font-bold text-ink">@Model.Order.TotalAmount.ToString("N0") تومان</dd>
                    </div>
                </dl>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                <form method="post" asp-page-handler="Retry">
                    <input type="hidden" name="orderId" value="@Model.Order.Id" />
                    <button type="submit" class="btn-accent">
                        <svg data-lucide="rotate-cw" class="w-4 h-4"></svg>
                        تلاش مجدد برای پرداخت
                    </button>
                </form>
                @if (simCard is not null)
                {
                    <a href="/i/@simCard.Number" class="btn-outline">بازگشت به صفحه شماره</a>
                }
            </div>
        }
        else
        {
            <a href="/" class="btn-outline">بازگشت به صفحه اصلی</a>
        }
    }
</section>
