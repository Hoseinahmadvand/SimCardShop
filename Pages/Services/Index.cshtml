@page "/services"
@model SimCardShop.Pages.Services.IndexModel
@{
    ViewData["Title"] = "خدمات دفتر";
}

<section class="section py-12 md:py-16">
    <div class="text-center max-w-xl mx-auto mb-10">
        <span class="eyebrow mb-4"><svg data-lucide="briefcase" class="w-3.5 h-3.5"></svg>خدمات دفتر</span>
        <h1 class="h2-section !text-2xl md:!text-3xl mb-2">خدمات دفتر پیشخوان</h1>
        <p class="text-secondary text-sm">علاوه بر خرید شماره، این خدمات نیز در دفتر ما ارائه می‌شود</p>
    </div>

    @if (Model.Services.Any())
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
            @foreach (var service in Model.Services)
            {
                <div class="card-base p-6">
                    <span class="w-11 h-11 rounded-xl bg-primary-50 text-primary flex items-center justify-center mb-4">
                        <svg data-lucide="check-circle-2" class="w-5 h-5"></svg>
                    </span>
                    <h2 class="font-bold text-ink mb-2">@service.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(service.Description))
                    {
                        <p class="text-sm text-secondary leading-6">@service.Description</p>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <svg data-lucide="briefcase" class="w-10 h-10 text-subtle"></svg>
            <p class="text-sm">در حال حاضر خدمتی ثبت نشده است.</p>
        </div>
    }
</section>
