@model SimCard
@{
    var operatorLabel = Model.Operator switch
    {
        OperatorType.HamrahAval => "همراه اول",
        OperatorType.Irancell => "ایرانسل",
        OperatorType.Rightel => "رایتل",
        _ => ""
    };

    var randomLabel = Model.RandomnessType switch
    {
        RandomnessType.Simple => "رند ساده",
        RandomnessType.Paired => "رند جفتی",
        RandomnessType.Sequential => "رند ترتیبی",
        RandomnessType.Mirror => "رند آینه‌ای",
        RandomnessType.Special => "رند ویژه",
        RandomnessType.Economic => "اقتصادی",
        _ => ""
    };

    var statusLabel = Model.Status switch
    {
        SimCardStatus.Available => "موجود",
        SimCardStatus.Reserved => "رزرو شده",
        SimCardStatus.Sold => "فروخته شده",
        SimCardStatus.Disabled => "غیرفعال",
        _ => ""
    };

    var statusBadgeClass = Model.Status switch
    {
        SimCardStatus.Available => "badge-success",
        SimCardStatus.Reserved => "badge-warning",
        _ => "badge-neutral"
    };
}
<a href="/i/@Model.Number" class="card-base hoverable @(Model.IsFeatured ? "card-featured" : "") group block p-5 relative">
    <div class="flex items-start justify-between mb-4">
        <span class="chip-primary">
            <svg data-lucide="signal" class="w-3 h-3"></svg>
            @operatorLabel
        </span>
        <span class="@statusBadgeClass">@statusLabel</span>
    </div>

    <div class="number-plate text-xl md:text-2xl mb-4 group-hover:text-primary transition-colors">
        @Model.DisplayNumber
    </div>

    <div class="flex items-center flex-wrap gap-1.5 mb-5">
        <span class="chip">@randomLabel</span>
        @if (Model.Kind == SimCardKind.Permanent)
        {
            <span class="chip">دائمی</span>
        }
        else
        {
            <span class="chip">اعتباری</span>
        }
    </div>

    <div class="flex items-end justify-between pt-4 border-t border-line">
        <div>
            @if (Model.DiscountPercent > 0)
            {
                <div class="text-xs text-subtle line-through">@Model.Price.ToString("N0") تومان</div>
            }
            <div class="text-lg font-extrabold text-ink">@Model.FinalPrice.ToString("N0") <span class="text-xs font-medium text-secondary">تومان</span></div>
        </div>
        <span class="flex items-center gap-1 text-sm font-semibold text-primary">
            مشاهده
            <svg data-lucide="arrow-left" class="w-3.5 h-3.5"></svg>
        </span>
    </div>
</a>
